def dfs():
    stack = [(0, 0, [])]
    visited = set()

    while stack:
        a, b, path = stack.pop()

        if (a, b) in visited:
            continue

        visited.add((a, b))
        path = path + [(a, b)]

        if a == 2 or b == 2:
            print("Solution Path:")
            for state in path:
                print(state)

            print("Goal Reached!")
            print("Total moves:", len(path) - 1)
            return

        # Fill Jug A
        stack.append((4, b, path))

        # Fill Jug B
        stack.append((a, 3, path))

        # Empty Jug A
        stack.append((0, b, path))

        # Empty Jug B
        stack.append((a, 0, path))

        # Pour A into B
        pour = min(a, 3 - b)
        stack.append((a - pour, b + pour, path))

        # Pour B into A
        pour = min(b, 4 - a)
        stack.append((a + pour, b - pour, path))


dfs()

