from collections import deque

def bfs(n):
    start = (tuple(range(n, 0, -1)), (), ())
    goal = ((), (), tuple(range(n, 0, -1)))

    q = deque([(start, [])])
    visited = {start}

    while q:
        state, path = q.popleft()

        if state == goal:
            for step in path:
                print(step)
            print("Goal Reached!")
            print("Total number of move:", len(path))
            return

        for i in range(3):
            if not state[i]:
                continue

            for j in range(3):
                if i == j:
                    continue

                rods = [list(r) for r in state]
                disk = rods[i][-1]

                if not rods[j] or disk < rods[j][-1]:
                    rods[i].pop()
                    rods[j].append(disk)

                    new_state = tuple(tuple(r) for r in rods)

                    if new_state not in visited:
                        visited.add(new_state)
                        move = f"Move disk {disk} from {i+1} to {j+1}"
                        q.append((new_state, path + [move]))

n = int(input("Enter number of disks: "))
