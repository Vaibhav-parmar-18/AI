def alpha_beta(node, alpha, beta, maximizing):

    if isinstance(node, int):
        return node

    if maximizing:
        best = float("-inf")

        for child in node:
            value = alpha_beta(child, alpha, beta, False)
            best = max(best, value)
            alpha = max(alpha, best)

            if beta <= alpha:
                print("Branch pruned at MAX")
                break

        return best

    else:
        best = float("inf")

        for child in node:
            value = alpha_beta(child, alpha, beta, True)
            best = min(best, value)
            beta = min(beta, best)

            if beta <= alpha:
                print("Branch pruned at MIN")
                break

        return best


game_tree = [
    [[3, 5], [6, 9]],
    [[1, 2], [0, -1]],
    [[7, 4], [8, 6]]
]

result = alpha_beta(game_tree, float("-inf"), float("inf"), True)
print("Best value:", result)

