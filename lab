from collections import deque

def bfs(grid, start, goal):

    q = deque([[start]])
    visited = {start}

    while q:

        path = q.popleft()
        x, y = path[-1]

        if (x, y) == goal:
            return path

        moves = [
            (-1, 0), (1, 0),
            (0, -1), (0, 1)
        ]

        for dx, dy in moves:

            nx = x + dx
            ny = y + dy

            if (0 <= nx < len(grid) and
                0 <= ny < len(grid[0]) and
                grid[nx][ny] == 0 and
                (nx, ny) not in visited):

                visited.add((nx, ny))
                q.append(path + [(nx, ny)])

    return None

