def minimax(tree, is_max):
    if isinstance(tree, int):
        return tree

    if is_max:
        best = -999
        for child in tree:
            value = minimax(child, False)
            best = max(best, value)
        return best

    else:
        best = 999
        for child in tree:
            value = minimax(child, True)
            best = min(best, value)
        return best


game_tree = [
    [3, 5],
    [2, 9],
    [1, 4]
]

result = minimax(game_tree, True)

print("Best value:", result)
